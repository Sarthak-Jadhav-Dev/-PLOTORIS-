# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Public Supabase vars (also needed for client-side auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_strong_random_jwt_secret_here

# ─── AI Provider Keys (Optional — users can also provide their own in-app) ───
# Gemini (Google) — fallback key if user hasn't configured one
GEMINI_API_KEY=your_google_gemini_api_key_here

# ─── Email / Resend (Optional) ─────────────────────────────────────────────────
# If not set, the app logs OTP to console for local testing
# RESEND_API_KEY=re_your_resend_api_key_here
