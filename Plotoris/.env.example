# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Public Supabase vars (also needed for client-side auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your_strong_random_jwt_secret_here

# ─── AI Provider Keys (Optional — users can also provide their own in-app) ───
# Gemini (Google) — fallback key if user hasn't configured one
GEMINI_API_KEY=your_google_gemini_api_key_here

# ─── Email / SMTP (Optional) ─────────────────────────────────────────────────
# If not set, the app uses Ethereal (fake SMTP for testing) and logs OTP to console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
